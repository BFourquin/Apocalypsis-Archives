:root{--ink:#eaf0fb;--dim:#a9b6cc;--gold:#ffc21a;--link:#8cc8ff;--panel:rgba(38,56,86,.74);--line:rgba(140,170,210,.28)}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);font:15px/1.5 system-ui,sans-serif;background:#05080f url(fond.webp) center/cover fixed no-repeat;min-height:100vh}
/* le voile bleu-gris n'existe que derrière les sections (.panel, nav) : le fond reste visible ailleurs */
h1,#status,.shade{text-shadow:0 1px 4px #000,0 0 10px #000}
a{color:var(--link);text-decoration:none}a:hover{text-decoration:underline}
h1{font-weight:600;font-size:22px;margin:0 0 12px}
nav.top{display:flex;gap:18px;flex-wrap:wrap;padding:12px 16px;background:var(--panel);border-bottom:1px solid var(--line)}
nav.top a{color:var(--ink)}nav.top a.cur{color:var(--gold)}
main{max-width:900px;margin:0 auto;padding:16px}
.panel,nav.top{backdrop-filter:blur(3px)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}
form.s{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 8px}
input[type=search],select,button{padding:8px 10px;background:rgba(8,14,26,.85);color:var(--ink);border:1px solid var(--line);border-radius:4px;font:inherit;max-width:100%}
input[type=search]{flex:1;min-width:220px}button{cursor:pointer}button:hover{border-color:var(--gold)}
small,.dim{color:var(--dim)}#status{color:var(--ink);margin:8px 0}
.r{border-bottom:1px solid var(--line);padding:10px 0}.r:last-child{border:0}
.r small{display:block}.r p{margin:4px 0;color:#d3dcec;overflow-wrap:anywhere}
mark{background:var(--gold);color:#000;padding:0 2px}
.tag{font-size:11px;border:1px solid var(--line);border-radius:3px;padding:0 6px;margin-left:6px;color:var(--gold)}
table{width:100%;border-collapse:collapse}td,th{padding:5px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{color:var(--dim);font-weight:600;font-size:13px}td.n,th.n{text-align:right;white-space:nowrap}
.prof{display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start}
/* l'avatar garde sa taille (jamais agrandi), est réduit au-delà de 128 px et ne se déforme jamais */
.av{border:1px solid var(--line);background:rgba(8,14,26,.5);line-height:0}
.av img{display:block;width:auto;height:auto;max-width:128px;max-height:128px;object-fit:contain}
.av.empty{width:128px;height:128px}
.stats{display:flex;gap:10px 24px;flex-wrap:wrap;margin:8px 0}.stats b{display:block;font-size:18px;color:var(--gold)}
.badges span{display:inline-block;margin:2px 6px 2px 0;font-size:12px;border:1px solid var(--line);border-radius:3px;padding:1px 6px}
/* accueil */
body.home main{max-width:560px;margin:0 auto;padding:58vh 16px 40px}
body.home .panel{padding:8px 20px}
body.home li{margin:.7em 0}
details summary{cursor:pointer;color:var(--dim);margin-top:6px}details[open] summary{color:var(--ink)}
.sr{position:absolute;left:-9999px}
@media(max-aspect-ratio:1/1){body.home main{padding-top:60vh}}
