beta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 18:56","score":0,"id":98938,"texte":"200200"},{"auteur":"Guillaume Tell","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/297.jpg","date_sans_annee":"03/11 19:06","score":0,"id":98940,"texte":"205000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 19:07","score":0,"id":98941,"texte":"210000"},{"auteur":"Guillaume Tell","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/297.jpg","date_sans_annee":"03/11 19:08","score":0,"id":98945,"texte":"215000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 19:11","score":0,"id":98947,"texte":"220000"}],"3":[{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"03/11 20:42","score":0,"id":99006,"texte":"J'espere que le transport est inclus moi, au prix ou sont arrivé les CLA..."},{"auteur":"NikoMook","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1542.jpg","date_sans_annee":"03/11 21:28","score":0,"id":99037,"texte":"Les CLA sont donc pour ricola.\n\nTransport et SAV assurés bien sur !!\n\nCordialement,\n\nNook el zook,"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"03/11 21:44","score":1,"id":99046,"positifs":{"remarquable":1},"texte":"transfert accepté"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 21:57","score":0,"id":99048,"texte":"PFFFffff a ce pris là, dommage... j'ai loupé l'heure..."},{"auteur":"NikoMook","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1542.jpg","date_sans_annee":"04/11 00:36","score":0,"id":99106,"texte":"Nous avons de quoi vous satisfaire commandants Bliz. Encore des CLA en provenances cette fois ci des kolkoz 116 et 53 de la planète glacée Zeta Dua.\n\n15000 unitées avec blindage en galactorium.\n\nMise à prix : 210000 lems l'unitée\n\nFin des enchères ... aujourd'hui à 21h.\n\nNous venons de mettre au point la chaine de fabrication des Bombes hyperatomiques. Nous en ferons cadeaux de 10 au commandant qui remportera cet enchère pour qu'il nous les test.\n\nCordialemeent,\n\nNook et zook, (re(re))mandaté pour le temps de cet enchère,"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"04/11 08:13","score":0,"id":99138,"texte":"si il y a des bha en cadeaux alors...\n\n211000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"04/11 09:57","score":0,"id":99152,"texte":"212000"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"04/11 13:19","score":0,"id":99266,"texte":"213000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"04/11 13:22","score":0,"id":99273,"texte":"214000"},{"auteur":"NikoMook","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1542.jpg","date_sans_annee":"04/11 18:14","score":0,"id":99589,"texte":"Encore quelques heures avant la fin de l'enchère ..."},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"04/11 19:22","score":0,"id":99661,"texte":"215000"},{"auteur":"NikoMook","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1542.jpg","date_sans_annee":"04/11 20:41","score":0,"id":99720,"texte":"Encore 20 minutes avant la fin de cet enchère ...\n\navec 10 bombinette en cadeaux ...\n\nNook el Zook,"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"04/11 20:42","score":0,"id":99722,"texte":"216000"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"04/11 20:58","score":0,"id":99734,"texte":"217000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"04/11 20:58","score":0,"id":99736,"texte":"219000"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"04/11 20:59","score":1,"id":99737,"positifs":{"remarquable":1},"texte":"220000"},{"auteur":"NikoMook","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1542.jpg","date_sans_annee":"04/11 21:20","score":0,"id":99744,"texte":"Bravo commandant ricola. Nous vous expedions les CLA de suite.\n\nNook el zook,"}],"2":[{"auteur":"Guillaume Tell","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/297.jpg","date_sans_annee":"03/11 19:11","score":0,"id":98948,"texte":"225000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 19:15","score":0,"id":98950,"texte":"Je m'incline cher ami, je m'incline..."},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/869.jpg","date_sans_annee":"03/11 20:07","score":0,"id":98968,"texte":"Bon aller, après mure réfflection, je continue...\n\n230000"},{"auteur":"ricola","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1428.jpg","date_sans_annee":"03/11 20:10","score":0,"id":98970,"texte":"Hé les copains, c'est moi qui a commencé l'enchere...\n\n235000"},{"auteur":"Bliz","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/f