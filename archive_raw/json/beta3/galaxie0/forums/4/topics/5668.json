lle !!!"},{"auteur":"Antares","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_0/forums_galactiques/avatars/1952.jpg","date_sans_annee":"06/02 23:06","score":0,"id":133538,"texte":"adjugé vendu à Araskel pour 100 Ma !"}]}}