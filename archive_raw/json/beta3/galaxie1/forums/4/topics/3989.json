iques/avatars/1483.jpg","date_sans_annee":"14/02 20:16","soutien":1,"score":0,"id":97912,"texte":"5.1 MA"},{"auteur":"Getcopy","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1532.jpg","date_sans_annee":"14/02 20:17","score":0,"id":97915,"texte":"Guigui, le pas de l'enchère est de 250Mo donc tu dois dire: 5.25Ma..."},{"auteur":"Hetad the return","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1198.jpg","date_sans_annee":"14/02 23:00","score":0,"id":98006,"texte":"7 ma"},{"auteur":"Krathos","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1583.jpg","date_sans_annee":"15/02 08:19","score":0,"id":98049,"texte":"9 Ma et 17 Ma si tu double ta proposition de renforcement!"},{"auteur":"Getcopy","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1532.jpg","date_sans_annee":"15/02 18:49","score":0,"id":98288,"texte":"Donc, je dois construire 50 SPAT??\nC'est ça?\nJe construit de suite..."},{"auteur":"Prince Kheldar","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1714.gif","date_sans_annee":"15/02 18:59","score":0,"id":98296,"texte":"20 MA avec le renforcement ^^"},{"auteur":"Getcopy","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1532.jpg","date_sans_annee":"15/02 19:00","score":0,"id":98297,"texte":"Renforcement lancé il y à 5 minutes..."},{"auteur":"Getcopy","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/1532.jpg","date_sans_annee":"15/02 19:05","score":0,"id":98303,"texte":"Vente terminée, j'envois l'offre..."}]}}