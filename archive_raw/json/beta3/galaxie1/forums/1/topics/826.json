resentation":1},"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"Ichimaru Gin","compteur":38,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/163.jpg","date_sans_annee":"27/06 12:37","score":0,"id":16965,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"avote"},{"auteur":"TKMA","compteur":11,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/537.jpg","date_sans_annee":"27/06 12:46","score":0,"id":16973,"texte":"A voté pour garantir son petit commerce."}],"3":[{"auteur":"juju_01","compteur":271,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/90.jpg","date_sans_annee":"27/06 12:47","score":1,"id":16974,"negatifs":{"orthographe":2,"presentation":2},"positifs":{"efforts":1,"humour":4},"texte":"A vorté\n\n;)"},{"auteur":"Robespierre","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/203.jpg","date_sans_annee":"27/06 13:40","soutien":2,"score":1,"id":17022,"negatifs":{"presentation":5},"positifs":{"adapte":6},"texte":"A Voté"},{"auteur":"Crimpra","compteur":15,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/383.jpg","date_sans_annee":"27/06 13:53","score":0,"id":17033,"negatifs":{"presentation":3},"positifs":{"adapte":3},"texte":"A voté"},{"auteur":"NkThor","compteur":32,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/79.jpg","date_sans_annee":"27/06 16:00","score":0,"id":17141,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A Voté (Hier...)"},{"auteur":"Lizaka","compteur":2723,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/275.jpg","date_sans_annee":"27/06 17:38","score":0,"id":17232,"negatifs":{"orthographe":1},"positifs":{"efforts":1},"texte":"J'ai donné ma voix à celui qui la mérite.\n\nHRP : le premier qui donne un point à ce message...les messages de ce sujet ne méritent pas de points, sauf efforts exceptionnels pour dissimuler un bête \"A voté\"."},{"auteur":"Barry","compteur":53,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/202.jpg","date_sans_annee":"27/06 17:51","score":0,"id":17242,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté."},{"auteur":"Feyd-Rautha","compteur":266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/93.jpg","date_sans_annee":"27/06 18:00","score":1,"id":17255,"positifs":{"humour":1},"texte":"A voté\n\nBourage d'urnes, moi ?"},{"auteur":"thegrumo","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/242.jpg","date_sans_annee":"27/06 18:44","score":0,"id":17314,"negatifs":{"orthographe":1},"positifs":{"roleplay":1},"texte":"à voté...\nenfin je croi ^-^"},{"auteur":"lord master","compteur":0,"date_sans_annee":"27/06 18:45","score":0,"id":17319,"texte":"à aussi voté."},{"auteur":"lord lemoi","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/272.jpg","date_sans_annee":"27/06 18:52","score":0,"id":17325,"texte":"à voté...\ntous comme les autre..."},{"auteur":"Leorique","compteur":387,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/16.gif","date_sans_annee":"27/06 19:02","score":7,"id":17333,"positifs":{"efforts":1,"humour":2,"roleplay":4},"texte":"Un drôle de personnage s’avance a l’assemblé, il porte un tambourin. Vêtu élégamment il se racle la gorge un moment … « Hrem hrem … ». il frappe sur son tambourin fortement.\n\nTCHING TCHING TCHANG (bruit du tambourin … je le fait mal je sais ;) ).\n\n« Oyez ! Oyez !\n\nBrave commandant, gente commandante … J’ai un message d’un certain Léorique des Umbraes a vous crier … » le crieur prend un papier et le lit d’un voix forte.\n\n« Bon … je l’ai dit … je l’ai fait … j’ai engagé un crieur parce que bon … autant que tout le monde l'entende bien .. ça n’a pas l’air de rentrer … » Le crieur lit le papier d’un air intrigué mais respecte fidèlement le texte.\n\n « Donc je le dit … et le redit … non je n’ai pas voté … merci de votre attention …  je vous dit que ça ne m’intéresse pas … »\n\n« post scriptum ... c’est une semi-plaisanterie mais bon … il faut bien passer un peu le temps … ».\n\nLe crieur cligne des yeux … se disant que c’est sûrement le texte le plus étrange qu’il ai jamais crié. Puis il s’en va avec un expression étrange."},{"auteur":"Lord Oblivion2","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/170.jpg","date_sans_annee":"27/06 20:42","score":0,"id":17482,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"à voté!"},{"auteur":"mercredi","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/450.jpg","date_sans_annee":"27/06 22:20","score":3,"id":17524,"positifs":{"humour":2,"roleplay":1},"texte":"Pour le deuxiéme tour ,le commandant mercredi ne s'est pas dérangé ,il a préfairé donner une procuration à son valet pour qu'il puisse mettre le bultin dans l'urne.\nUne fois cette perte de temps fini le valet sort un petit bout de papier et se mit a le lire :\n\" A voté ,et ne faites pas un troisiéme tour sinon je vous envoie un esclve pour voter ...\"\nUne fois le méssage terminé le valet reparti."},{"auteur":"Céthro","compteur":220,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/20.jpg","date_sans_annee":"27/06 22:25","soutien":1,"score":-1,"id":17525,"negatifs":{"presentation":4},"positifs":{"adapte":3},"texte":"a voté!"},{"auteur":"Tsuga","compteur":0,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/679.jpg","date_sans_annee":"27/06 22:58","score":0,"id":17544,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"Keldon","compteur":0,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/661.jpg","date_sans_annee":"27/06 23:00","score":0,"id":17549,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"phill3333","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/194.jpg","date_sans_annee":"28/06 13:19","score":0,"id":17703,"texte":"A voté\n\nMais est ce que cela va vraiment changé notre vie à nous, les petits commandants?\nJe l'espère..."},{"auteur":"Melfice","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/449.jpg","date_sans_annee":"28/06 13:49","score":0,"id":17724,"texte":"Histoire de faire dans l'originalité... A voté !"},{"auteur":"Drakhaon","compteur":24,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/487.jpg","date_sans_annee":"28/06 14:26","score":0,"id":17743,"texte":"A voté"},{"auteur":"Aranéides","compteur":0,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/699.png","date_sans_annee":"28/06 14:51","score":0,"id":17760,"texte":"a voté"}],"4":[{"auteur":"dyrun","compteur":3,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/411.jpg","date_sans_annee":"28/06 16:05","score":0,"id":17788,"texte":"a voté"},{"auteur":"Feyd-Rautha","compteur":266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/93.jpg","date_sans_annee":"28/06 19:32","score":0,"id":17886,"negatifs":{"hors_sujet":1},"positifs":{"efforts":1},"texte":"A voté\n\nUne petite dernière fois... pour la route..."},{"auteur":"Seigneur Grimaldus","compteur":806,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/17.jpg","date_sans_annee":"28/06 20:42","score":0,"id":17920,"texte":"\"Bon si j'ai bien compris le représentant de 'chéplukoi' est élu..\nJ'attends qu'il nous présente son Gouvernement..\""},{"auteur":"Leorique","compteur":387,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/16.gif","date_sans_annee":"28/06 20:47","score":1,"id":17923,"positifs":{"humour":1},"texte":"L’albinos ricane. « c’est vrai que lire au travers d’un masque ça doit pas être évident … mais bon … qu’est ce qu’on ne sacrifierais pas pour un peu de théâtral hein … ? ».\n\n« Ha mais  … vous ne savez peut être pas lire ! … ça expliquerais bien des choses … pourtant je croyais avoir dit aux bureaucrates de faire en sorte que les votes et les bulletins aient des dispositif spécial pour ça … halala … »\n\n« Enfin … désolé … ça me taraudait depuis un moment … mais puisque vous semblez habitué au fait de diverger un peu du sujet … je m’y met aussi ».\n\n« C’est Smith representant du peuple de la \"Star\" qui a gagné pour ceux qui ne savent pas lire au fait … » L’albinos ricane légèrement. « Mais moi je m’en fiche … »"},{"auteur":"Seigneur Grimaldus","compteur":806,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/17.jpg","date_sans_annee":"28/06 20:57","score":0,"id":17930,"texte":"\"A vrai dire, je n'ai pas voté,et ne me suis pas interressé à ces élections..Pour vous dire,je n'ai meme pas chercher à savoir si les candidats avaient l'intention de respecter leurs paroles..\""}]}}