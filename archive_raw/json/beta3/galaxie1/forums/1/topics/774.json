org/beta3/galaxie_1/forums_galactiques/avatars/485.jpg","date_sans_annee":"25/06 14:34","score":4,"id":15742,"negatifs":{"presentation":1,"hors_sujet":1},"positifs":{"adapte":4,"humour":1,"roleplay":1},"texte":"HRP\nPourquoi est-ce-que des personnes sont gratifiées par un \"message adapté\" lorsqu'elles disent juste: \"a voté\"?\nfaudrait m'expliquer"},{"auteur":"Lokki","compteur":281,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/85.gif","date_sans_annee":"25/06 14:39","score":0,"id":15745,"negatifs":{"hors_sujet":2},"positifs":{"remarquable":1,"roleplay":1},"texte":"Parfois on voit même des humour décapant ou RP intéressant. Tout est bon pour booster le respect de ses alliés on dirait..."},{"auteur":"Sandalphon","compteur":592,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/448.jpg","date_sans_annee":"25/06 14:42","score":2,"id":15748,"negatifs":{"hors_sujet":3},"positifs":{"humour":4,"roleplay":1},"texte":"HRP//Imaginez ce qu'il se passerait en plus si certains postaient \"a voté\" 3 fois... Oh, doux Jésus, mais... c'est déjà fait !! Merci de votre si active participation F-R H.//HRP"},{"auteur":"L'AntéChrist","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/639.jpg","date_sans_annee":"25/06 15:51","score":0,"id":15775,"negatifs":{"hors_sujet":1},"positifs":{"efforts":1},"texte":"Le seigneur de l'apocalypse a voté ."},{"auteur":"La Cité des Vissäyan","compteur":171,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/452.gif","date_sans_annee":"25/06 15:57","score":0,"id":15777,"texte":"HRP : Il ne devrait y avoir aucune notation dans ces messages... Adaptés, Humoristiques ou autres...\nNe notez pas ce message, ceci n'a pour but que de donner mon avis sur les notations (en HRP) et de compléter avec un peu de RP...\n\n\"Commandants, encore un jour de votes !\nN'oubliez pas de choisir celui qui vous semble le plus apte à prendre le rôle de la Présidence.\n\nA vos bulletins !\""},{"auteur":"NeMoS","compteur":51,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/446.jpg","date_sans_annee":"25/06 18:27","score":0,"id":15920,"texte":"Après quelques rotations de planètes d'absence, j'ai voté (surement dans les derniers....) :("},{"auteur":"Nounours Brun","compteur":8,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/518.jpg","date_sans_annee":"25/06 19:02","score":0,"id":15995,"negatifs":{"presentation":2},"positifs":{"adapte":2},"texte":"Grumph...a voté\n\n(ne me mettez pas de message adapté ou autre c'est pas mon but)"}],"2":[{"auteur":"luffy","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/253.jpg","date_sans_annee":"24/06 09:55","score":0,"id":15217,"negatifs":{"presentation":1},"positifs":{"efforts":1},"texte":"a voté"},{"auteur":"Feyd-Rautha","compteur":266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/93.jpg","date_sans_annee":"24/06 10:03","score":3,"id":15219,"positifs":{"humour":3},"texte":"A vos thés !"},{"auteur":"Commandeur Valorys","compteur":865,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/15.jpg","date_sans_annee":"24/06 10:13","score":2,"id":15226,"positifs":{"adapte":2},"texte":"A voté en son âme et cosncience au nom de la Fédération Comenorienne"},{"auteur":"Sandalphon","compteur":592,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/448.jpg","date_sans_annee":"24/06 10:19","score":7,"id":15228,"positifs":{"efforts":1,"adapte":1,"roleplay":5},"texte":"Un éclair blanc s'abattit sur l'isoloir, et tout fut carbonisé.\nLorsque l'intensité lumineuse baissa, seul un bulletin parmi les 5 présents était intact, et voletait dans la salle, pour aller atterrir comme par miracle dans la fente de l'urne.\nUne voix puissante se fit entendre alors dans le ciel :\n\"A voté !\"."},{"auteur":"Capitaine Kortzanov","compteur":196,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/297.jpg","date_sans_annee":"24/06 10:30","score":0,"id":15232,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté."},{"auteur":"Ichimaru Gin","compteur":38,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/163.jpg","date_sans_annee":"24/06 11:23","score":0,"id":15271,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"Aldur","compteur":63,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/138.gif","date_sans_annee":"24/06 12:19","score":1,"id":15303,"negatifs":{"presentation":1},"positifs":{"adapte":2},"texte":"a voté"},{"auteur":"Baron Murphy","compteur":1,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/258.jpg","date_sans_annee":"24/06 12:27","score":1,"id":15311,"negatifs":{"presentation":1},"positifs":{"adapte":2},"texte":"A voté"},{"auteur":"Sigma","compteur":197,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/485.jpg","date_sans_annee":"24/06 12:29","score":1,"id":15314,"positifs":{"adapte":1},"texte":"Moi, SigMa von Eisemeer, ai donné ma voix."},{"auteur":"thegrumo","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/242.jpg","date_sans_annee":"24/06 13:23","score":0,"id":15341,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"à voté..."},{"auteur":"Crimpra","compteur":15,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/383.jpg","date_sans_annee":"24/06 13:24","score":1,"id":15342,"negatifs":{"presentation":1},"positifs":{"adapte":2},"texte":"a voté"},{"auteur":"Leorique","compteur":387,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/16.gif","date_sans_annee":"24/06 13:27","score":6,"id":15344,"positifs":{"humour":2,"roleplay":4},"texte":"Leorique ricane. « ça y est les bureaucrates ont encore gaffé et Jafnhar va me tomber dessus en hurlant a la tyrannie et au monstre sanguinaire » l’albinos s’esclaffe avec un rire totalement ironique. « non … non … je leurs avait préciser de mettre vote blanc … pas Blanc … ça prete a confusion … il … on va croire que c’est moi après …  ».Leorique sourit. « Je vous rassure , je ne suis pas intéressé du tout … ce n’est pas une dictature déguisée … »\n\n« donc … Blanc c’est bien le vote blanc … Aucun rapport avec moi … ». ricanement\n\n« quoi ... ? non je n'ai pas voté ... vous me prenez pour quoi ? je vous dit que ça m'interesse pas ... faut vraiment que j'embauche des crieurs moi ... »."},{"auteur":"Seigneur Grimaldus","compteur":806,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/17.jpg","date_sans_annee":"24/06 13:30","score":2,"id":15348,"positifs":{"humour":2},"texte":"\"Au moins si il pense que c'est vous on aura moins de blanc et les candidats pourront ainsi etre mieux départagés...Ahaha!!\"\n\nLe Seigneur Grimaldus fait voler un bulletin jusqu'à l'urne..\n\n\"Pour la beauté du geste..\"\n\nHRP: Humour :D"},{"auteur":"Grosjojo","compteur":37,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/512.jpg","date_sans_annee":"24/06 13:51","score":6,"id":15356,"positifs":{"remarquable":1,"humour":5},"texte":"Gorsjojo aime bien rire alors il a fait plouf plouf\n\nj'éspère que le président sera marrant et que chaque soir il nous fera des  boutades !\n\nà oui j'oubliais\n\na voté !\nbisou bisou"},{"auteur":"Mr Muffle","compteur":188,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/611.jpg","date_sans_annee":"24/06 13:53","score":3,"id":15359,"negatifs":{"presentation":1},"positifs":{"efforts":1,"humour":2,"roleplay":1},"texte":"\"A voté...\""},{"auteur":"Ketze","compteur":346,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/317.gif","date_sans_annee":"24/06 14:06","soutien":2,"score":4,"id":15366,"negatifs":{"presentation":1},"positifs":{"efforts":3,"humour":1,"roleplay":1},"texte":"a voté"},{"auteur":"Templar","compteur":137,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/339.jpg","date_sans_annee":"24/06 14:42","score":0,"id":15372,"negatifs":{"presentation":1},"positifs":{"efforts":1},"texte":"A voté."},{"auteur":"red","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/175.jpg","date_sans_annee":"24/06 14:53","score":3,"id":15376,"negatifs":{"orthographe":1},"positifs":{"efforts":3,"adapte":1},"texte":"a voter(sans grande conviction)"},{"auteur":"L'essaim","compteur":4,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/484.jpg","date_sans_annee":"24/06 15:33","score":4,"id":15384,"positifs":{"efforts":4},"texte":"La reine de l'essaim s'est prooncée.\n\nA voté."},{"auteur":"Feyd-Rautha","compteur":266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/93.jpg","date_sans_annee":"24/06 16:38","score":1,"id":15411,"negatifs":{"presentation":1},"positifs":{"efforts":1,"adapte":1},"texte":"A voté"}],"1":[{"auteur":"Gouvernement","compteur":751,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/2.jpg","date_sans_annee":"23/06 19:59","score":6,"id":15015,"positifs":{"remarquable":6},"texte":"Bonsoir a tous …\n\nComme il a été prévu dans le calendrier de la mise en place des élections. Les campagnes pour la présidence sont arrêtées dés ce message. Je vous remercie de ne pas essayer de faire d’autre messages incitant a voter pour vous ou pour l’un des candidats. En effets il y a eu assez de temps pour cela.\n\nLe moment n’est plus a la présentation mais bien aux élections.\n\nJe vous demande donc de voter pour le président de votre choix parmi les quatre candidats qui se sont présentés, ou si aucun choix ne vous correspond ou pour d’autre raisons votez blanc. Le vote durera trois jours : c’est a dire finira le lundi a 20 heure (heure française), comme annoncé dans le planning.\n\nSi aucun candidat n’a une majorité absolue alors nous procéderons a une deuxième tour qui durera deux jours.\n\nLes bulletins sont donc les commandants :\n\nSigma.\nWinston.\nBarry.\nJafnhar.\n\nOu le vote blanc.\n\nA vos votes …"},{"auteur":"Bestla","compteur":33,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/84.jpg","date_sans_annee":"23/06 20:38","score":0,"id":15032,"texte":"A voté ! (HRP : ceci est un UP, merci de faire de même et de ne pas voter ce message)"},{"auteur":"Gips","compteur":17,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/146.jpg","date_sans_annee":"23/06 20:42","soutien":1,"score":0,"id":15033,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté..."},{"auteur":"Aruzan","compteur":36,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/543.jpg","date_sans_annee":"23/06 21:15","score":-1,"id":15048,"negatifs":{"presentation":1},"texte":"à voté"},{"auteur":"alexandre","compteur":17,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/137.jpg","date_sans_annee":"23/06 21:17","score":0,"id":15049,"negatifs":{"presentation":1},"positifs":{"efforts":1},"texte":"a voté"},{"auteur":"Le fou des Ombres","compteur":204,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/247.gif","date_sans_annee":"23/06 21:25","soutien":2,"score":12,"id":15052,"positifs":{"efforts":1,"adapte":1,"humour":9,"roleplay":1},"texte":"Euh... J'ai éclaté un poussin sur ma boite à vote... Je peux en avoir une autre?"},{"auteur":"Gros Bisous","compteur":214,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/130.jpg","date_sans_annee":"23/06 21:30","score":7,"id":15054,"positifs":{"adapte":1,"remarquable":5,"humour":1},"texte":"Gros Bisous n'aime pas l'injustice,Gros Bisous voudrait que tous les commandants soient élus, mais ce n'est pas possible alors Gros Bisous fait un bisous à tous les candidats,... sur le nez, dans le coup, tout partout!! ^^ .\n\nA voté..\n\nbisous mes choux ;)"},{"auteur":"La Cité des Vissäyan","compteur":171,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/452.gif","date_sans_annee":"23/06 21:44","score":4,"id":15063,"positifs":{"efforts":1,"adapte":3},"texte":"La Cité vient de donner sa voix."},{"auteur":"Aruzan","compteur":36,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/543.jpg","date_sans_annee":"23/06 22:37","score":0,"id":15106,"negatifs":{"orthographe":1,"hors_sujet":1},"positifs":{"efforts":1,"remarquable":1},"texte":"Pour moi chaque candidat devrai faire une sorte de mandat partagé car il se vale tous et donc disons qu'une semaine Barry est président puis ce sera le tour d'un autre et ainsi de suite jusqu'aux prochaine éléction\n*ainsi les paroles d'Aruzan résonnairent contre les parois de l'assemblée*"},{"auteur":"Lizaka","compteur":2723,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/275.jpg","date_sans_annee":"23/06 22:55","score":2,"id":15123,"negatifs":{"orthographe":1},"positifs":{"efforts":3},"texte":"Moi, Grand Passeur des Sauvés, ai donné ma voix à celui qui la mérite."},{"auteur":"juju_01","compteur":271,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/90.jpg","date_sans_annee":"23/06 22:59","score":11,"id":15129,"positifs":{"remarquable":1,"humour":10},"texte":"J'ai accomplit mon devoir, mais je me demande bien qui peut etre le commandant blanc..."},{"auteur":"Lokki","compteur":281,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/85.gif","date_sans_annee":"23/06 23:08","score":0,"id":15141,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté..."},{"auteur":"amrod","compteur":98,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/89.jpg","date_sans_annee":"23/06 23:36","score":1,"id":15159,"positifs":{"adapte":1},"texte":"Pareil que le Commandant qui me precede."},{"auteur":"Tiz","compteur":165,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/209.jpg","date_sans_annee":"23/06 23:37","soutien":2,"score":7,"id":15162,"positifs":{"efforts":1,"humour":5,"roleplay":1},"texte":"La bête entra alors dans l'isoloir, pour en repartir une demi-heure après. Des gens qui se demandaient ce qu'ils faisaient ont vite fait regardé dedans. Elle essayait de se débrouiller avec ses pattes et ses dents pour prendre un bulletin non griffé et le mettre dans l'enveloppe.\nElle sortit enfin avant de mettre son enveloppe dans l'urne, la banane aux lèvres, puis repartit en gardant le fruit entre ses dents (HRP-Noob ==> Attention, ceci est une métaphore <==).\n\nPuis elle repartit vers les autres salles de l'Assemblée."},{"auteur":"emyn muil","compteur":113,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/123.jpg","date_sans_annee":"23/06 23:39","score":1,"id":15163,"positifs":{"remarquable":1},"texte":"emyn muil a voté bizarre y a que 4 commandants ah oui!\nl'autre est un fantôme puisqu'il est blanc!"},{"auteur":"A","compteur":176,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/264.jpg","date_sans_annee":"23/06 23:57","score":3,"id":15169,"positifs":{"humour":2,"roleplay":1},"texte":"Les millions de Kamarades du Monde de A s' étaient présentés en masse au bureau de vote.\nAprès leur avoir expliqué qu' un SEUL vote était autorisé ... uniquement un seul par nation, il fallut donc se résoudre à la raison commune.\nLes Kamarades rentrèrent chez eux et seul, leur Kamarade Président se déplaca en personne jusqu' à l' urne pour y glisser son bulletin.\n\nConfiant dans la sagesse populaire (et dans les 20 000 leems pariés) il retourna sur son monde natal."},{"auteur":"Céthro","compteur":220,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/20.jpg","date_sans_annee":"24/06 07:19","soutien":1,"score":1,"id":15194,"negatifs":{"hors_sujet":1},"positifs":{"adapte":2},"texte":"hop!"},{"auteur":"Xblade","compteur":35,"date_sans_annee":"24/06 07:39","score":1,"id":15196,"negatifs":{"presentation":1},"positifs":{"adapte":2},"texte":"a voté ^^"},{"auteur":"live_ocin","compteur":372,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/533.jpg","date_sans_annee":"24/06 09:12","score":2,"id":15202,"negatifs":{"presentation":1},"positifs":{"remarquable":2,"humour":1},"texte":"a voté"},{"auteur":"narutos","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/556.jpg","date_sans_annee":"24/06 09:47","score":0,"id":15210,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"a vote aussi"}],"4":[{"auteur":"Scorbut","compteur":1059,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/531.jpg","date_sans_annee":"25/06 19:49","score":2,"id":16018,"negatifs":{"presentation":1},"positifs":{"humour":3},"texte":"Bon sang, j'ai la tête enflée d'avoir réfléchi à mon vote, mais enfin, j'ai réussi à prendre une décision. (pfffoouuu, ça m'a donné soif, ces histoires, tiens...)"},{"auteur":"Roots Boy","compteur":923,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/394.jpg","date_sans_annee":"25/06 19:53","score":1,"id":16020,"negatifs":{"presentation":2},"positifs":{"efforts":1,"adapte":1,"humour":1},"texte":"a voté"},{"auteur":"Keldon","compteur":0,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/661.jpg","date_sans_annee":"25/06 21:59","score":0,"id":16079,"negatifs":{"presentation":1},"positifs":{"adapte":1},"texte":"A voté."},{"auteur":"Hanabi","compteur":45,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_1/forums_galactiques/avatars/432.jpg","date_sans_annee":"25/06 22:10","score":0,