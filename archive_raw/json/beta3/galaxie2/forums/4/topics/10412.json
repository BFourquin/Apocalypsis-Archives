re: dans 72 h\n\nbonne vente\ngénéral blackstar"},{"auteur":"Eventine","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3341.gif","date_sans_annee":"06/05 09:49","score":0,"id":271939,"texte":"1000ma"},{"auteur":"général blackstar","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3214.jpg","date_sans_annee":"06/05 10:52","score":1,"id":271948,"positifs":{"efforts":1},"texte":"le prix de départ est de 10 000"},{"auteur":"Eventine","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3341.gif","date_sans_annee":"06/05 10:54","score":0,"id":271949,"texte":"10 000ma.\n\nDésolé."},{"auteur":"général blackstar","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3214.jpg","date_sans_annee":"07/05 13:55","score":0,"id":272331,"texte":"up 10 000 pour plus de 110 planetes se n'est pas cher"},{"auteur":"Mr HILTON","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3419.gif","date_sans_annee":"07/05 14:36","score":0,"id":272337,"texte":"11 000 ma"},{"auteur":"Eventine","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3341.gif","date_sans_annee":"07/05 19:02","score":0,"id":272430,"texte":"15 000ma"},{"auteur":"Mr HILTON","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3419.gif","date_sans_annee":"08/05 08:14","score":0,"id":272683,"texte":"19 000 ma on joue !!?"},{"auteur":"Eventine","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3341.gif","date_sans_annee":"08/05 10:59","score":0,"id":272709,"texte":"20 000ma"},{"auteur":"général blackstar","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3214.jpg","date_sans_annee":"08/05 11:59","score":0,"id":272766,"texte":"les prix montent, montent et montent mais qui vas reussirent a gagner les 114 planetes nous le serons dans un peu plus de 48 h a moi