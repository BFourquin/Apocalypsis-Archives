archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"25/04 16:11","soutien":2,"score":0,"id":47002,"texte":"Bon, je monte à...15leems, mais il faut me le garder un petit mois...:)"},{"auteur":"San Hill","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1254.jpg","date_sans_annee":"25/04 16:12","score":0,"id":47003,"texte":"16 ££"},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:12","score":0,"id":47004,"texte":"100£ ( je fais une folie!)"},{"auteur":"daetha","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/807.jpg","date_sans_annee":"25/04 16:13","score":0,"id":47005,"texte":"101"},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:15","score":0,"id":47006,"texte":"1000 ( va falloir que je fasse le régime maintenant)"}],"4":[{"auteur":"Arthérius","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/723.gif","date_sans_annee":"26/04 16:53","score":0,"id":47773,"texte":"Ca devient du nimporte quoi cette enchère ...\n\nParisii, vous auriez du nous préciser que ce système était équipé de SPAT à 3 milliards de protection, de planètes avec 15 gisements tous exploitées, et que celui ci était livré avec 10 millions de CA, 1 million d' Ionique et 35 000 CLH ..."},{"auteur":"Chacomat","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/850.jpg","date_sans_annee":"26/04 18:40","score":0,"id":47864,"texte":"610"},{"auteur":"Asurmen","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/375.jpg","date_sans_annee":"26/04 19:29","score":0,"id":47892,"texte":"612."},{"auteur":"Asurmen","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/375.jpg","date_sans_annee":"26/04 19:31","score":0,"id":47894,"texte":"A, enfin.\n\nSans rancune..."},{"auteur":"Chacomat","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/850.jpg","date_sans_annee":"26/04 19:36","score":0,"id":47896,"texte":"613"},{"auteur":"Nute Gunray","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/824.jpg","date_sans_annee":"26/04 22:35","score":0,"id":47960,"texte":"623 milliards."},{"auteur":"Hermes","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/546.jpg","date_sans_annee":"26/04 22:57","soutien":1,"score":0,"id":47966,"texte":"Edit : pardon, j'avais pas vu que les enchères étaient finies."},{"auteur":"Nute Gunray","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/824.jpg","date_sans_annee":"26/04 23:12","score":0,"id":47969,"texte":"633 milliards."},{"auteur":"Vladimir Harkonnen","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/208.jpg","date_sans_annee":"27/04 01:23","soutien":1,"score":0,"id":47984,"texte":"Les enchères ne reviennent-elles pas à Asurmen pour 612 Ma ?\n\nDe plus, il me semble que les autres ecnhères étaient hors délai ?\n\nPeut-être que si Nute Gunray avait prévenu qu'il se connectait tard le soir, Parisii aurait pu prolonger la fin ?\n\n(comment je me rattrape avec un EDIT...)"},{"auteur":"Parisii","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/419.jpg","date_sans_annee":"27/04 01:29","soutien":2,"score":0,"id":47985,"texte":"L'enchère revient donc à Asurmen, pour 612 milliards.\n\nToutes les autres enchères ont été placées le délai dépassé.\n\nCher Nute Gunray, je vois que vous enchérissez souvent après le délai écoulé, tard le soir.\nSi vous ne pouviez pas le faire avant, vous auriez du me prévenir et j'aurais rallongé le temps de l'enchère.\n\nMerci à tous pour votre participation."},{"auteur":"Nute Gunray","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/824.jpg","date_sans_annee":"27/04 04:11","score":0,"id":47991,"texte":"Nous sommes désolés de ce désagrément encourut, commandant Parisii.\nSachez cependant que, habitant hors de France et subissant de plein fouet le décalage horaire, ce genre d’enchère finit beaucoup trop tôt pour nous.\nJe ne crois pas être le seul vivant à l’étranger, il serait donc aimable de donner une chance à tout le monde.\nMerci de votre compréhension et sincères félicitations a ce cher Asurmen."},{"auteur":"Jason Casper","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/521.gif","date_sans_annee":"27/04 04:55","score":0,"id":47992,"texte":"Je soutiens le commandant Nute Gunray dans cette proposition. Pour moi aussi, ces encheres se terminent bien trop tot. Cependant, il est evident que la minorite que nous representons peut difficilement imposer son rythme de vie aux autres commandants.\nQuelques heures de plus seraient en tout cas les bienvenues (a voir les interventions dans cette salle, la plupart des commandants pratiquent de longues heures supplementaires en soiree ;-), je suppose donc que cela ne penaliserait personne)"},{"auteur":"Parisii","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/419.jpg","date_sans_annee":"27/04 10:40","soutien":2,"score":0,"id":48052,"texte":"C'est justement ce que j'étais en train de proposer, mais à mon grand désespoir vous auriez du me prévenir avant, je ne peux après la fin des enchères changer la règle de l'enchère.\n\nLa prochaine cela sera pris en compte rassurez vous."},{"auteur":"pigeon","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1307.jpg","date_sans_annee":"27/04 12:49","score":0,"id":48128,"texte":"Vendez vous le 37 parisii? je vous l'achetes 10000 milliard"},{"auteur":"Parisii","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/419.jpg","date_sans_annee":"27/04 13:13","soutien":2,"score":0,"id":48136,"texte":"Non, le 37 est l'un des systèmes auquel je tiens. Il est le symbol d'une guerre passée dont je me dois de faire perdurer le souvenir.\n\nEt puis je ne l'ai plus, du moins dans son intégralité."},{"auteur":"Jason Casper","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/521.gif","date_sans_annee":"27/04 14:46","score":0,"id":48197,"texte":"Oh, pas de problemes, commandant Parisii. Je ne pensais plus a cette enchere (ou meme quelques heures n'auraient pas ete suffisante pour moi), mais plutot d'une maniere generale pour les encheres futures."},{"auteur":"Wolverine","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/308.gif","date_sans_annee":"27/04 14:58","score":0,"id":48207,"texte":"1 leem"},{"auteur":"Nute Gunray","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/824.jpg","date_sans_annee":"27/04 17:27","score":0,"id":48270,"texte":"Merci, commandant Parisii.\nVous êtes toujours à l'écoute de vos prochains, et c’est une grande qualité.\nPuissiez-vous prospérer dans cette galaxie (c’est surement déjà le cas) et rendez-vous aux prochaines enchères... ;)"}],"2":[{"auteur":"Cesco Imperator","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"25/04 16:17","soutien":2,"score":0,"id":47007,"texte":"Allez, Parisii va se vexer. 10 millions."},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:18","score":0,"id":47009,"texte":"Mais non, pourquoi se vexerait-il?, Allez, 10 000 001.\n\n(Parisii tu as un MP)"},{"auteur":"Hynotane","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/461.jpg","date_sans_annee":"25/04 16:33","score":0,"id":47014,"texte":"11 millions"},{"auteur":"daetha","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/807.jpg","date_sans_annee":"25/04 16:33","score":0,"id":47016,"texte":"12Mo ( pas de coruption Mystèrax !)"},{"auteur":"Nute Gunray","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/824.jpg","date_sans_annee":"25/04 16:37","score":0,"id":47020,"texte":"15 Millions."},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:47","score":0,"id":47026,"texte":"16 millions ( non t'inquiète pas daetha y a pas de corruption, parisii tu as un autre MP)"},{"auteur":"Gemnoth-Sinn","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/720.jpg","date_sans_annee":"25/04 16:48","soutien":2,"score":0,"id":47028,"texte":"17 millions"},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:48","score":0,"id":47029,"texte":"17 000 001£"},{"auteur":"daetha","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/807.jpg","date_sans_annee":"25/04 16:48","score":0,"id":47030,"texte":"18Mo ( ya intéretparce que sinon, je deviens ta coiffeuse. Mais moi je fais tout au sabre et je fais des écarts parfois^^)"},{"auteur":"Mystèrax","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"25/04 16:50","score":0,"id":47033,"texte":"18 000 001 ( et quand bien même il y aurait corruption; cela ne te regarderait pas)"},{"auteur":"Arthérius","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/723.gif","date_sans_annee":"25/04 16:51","score":0,"id":47034,"texte":"100 milliards!\n\nEn rapport avec ce que je vous ai dit Cdt Parisii\n\nEDIT : contre perf, gemnoth!"},{"auteur":"Gemnoth-Sinn","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/720.jpg","date_sans_annee":"25/04 16:51","soutien":2,"score":0,"id":47035,"texte":"edit: oups, Artherius a posté avant moi"}