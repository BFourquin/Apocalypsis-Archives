iques/avatars/1434.jpg","date_sans_annee":"31/05 19:37","soutien":1,"score":0,"id":79585,"texte":"Moi ce qui me fait pleurer, c'est le prix que certains mette pour la petite marchandise"},{"auteur":"max","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1000.jpg","date_sans_annee":"31/05 19:39","score":0,"id":79587,"texte":"ça m'en fera que 5mo^^\n50ma"},{"auteur":"Général_Louis","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1149.jpg","date_sans_annee":"31/05 19:46","score":0,"id":79602,"texte":"51 Ma"},{"auteur":"max","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1000.jpg","date_sans_annee":"31/05 19:47","score":0,"id":79609,"texte":"52ma"}],"2":[{"auteur":"Général_Louis","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1149.jpg","date_sans_annee":"31/05 19:48","score":0,"id":79612,"texte":"Je monte pas plus pour de la marchandise bas de gamme."},{"auteur":"Hotfoot","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1186.jpg","date_sans_annee":"01/06 13:16","score":0,"id":79990,"texte":"De la marchandise bas de gamme? Tu veut que je t'en evnoi sur ta pm 100mln de fregates de combat...\nOk 52 mlds pour max..."},{"auteur":"Général_Louis","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1149.jpg","date_sans_annee":"01/06 13:19","score":0,"id":79995,"texte":"Contre des Millions de CLA? Impossible, je ionise la flotte, et après les pauvres frégates de combat restante se font détruire par mes CLA.\n\nJe le sais, Kyle m'a dit que ça casse trop vite ces jou-jou."},{"auteur":"Hotfoot","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1186.jpg","date_sans_annee":"01/06 13:26","score":0,"id":80011,"texte":"Oui mais avant de les ioniser: un combat directe ...\nEnfin bref les encheres sont fini donc n'en parlons plus..."}]}}