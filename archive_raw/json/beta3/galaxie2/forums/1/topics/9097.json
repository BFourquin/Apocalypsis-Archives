e_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"12/02 17:03","soutien":2,"score":0,"id":238583,"texte":"up"},{"auteur":"Giddy Séod","compteur":300,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3054.jpg","date_sans_annee":"12/02 17:24","score":0,"id":238598,"texte":"La Asyrean Financial & Trade Corp. a fait peser sa voix."},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"13/02 09:17","score":0,"id":238975,"texte":"UP"}],"1":[{"auteur":"Cesco Imperator","compteur":3122,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"10/02 09:57","soutien":2,"score":6,"id":237003,"positifs":{"adapte":5,"roleplay":1},"texte":"\"Commandants, Commandantes,\n\nQuelle place voulez-vous que l'Assemblée Galactique occupe dans le futur système politique ?\n\nSeulement lieu d'expression ? tout en sachant qu'aucune proposition à ce jour ne va en ce sens...\n\nDotée d'un pouvoir législatif ?\n\nOu bien d'un pouvoir judiciaire en prime, sanctionnant les commandants ?\n\nExprimez-vous.\n\nVote de Trois jours, il faut accélérer.\""},{"auteur":"maître anubis","compteur":32,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2198.jpg","date_sans_annee":"10/02 09:59","score":0,"id":237006,"texte":"A voter"},{"auteur":"Général Turon","compteur":81,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2970.jpg","date_sans_annee":"10/02 10:03","score":0,"id":237007,"texte":"A voté"},{"auteur":"lord skywalker","avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2019.jpg","date_sans_annee":"10/02 10:05","score":0,"id":237009,"texte":"A voté^^"},{"auteur":"Rosa L.","compteur":1595,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2330.jpg","date_sans_annee":"10/02 10:17","soutien":2,"score":1,"id":237012,"positifs":{"humour":1},"texte":"Vote effectué"},{"auteur":"Yul Harkonnen","compteur":499,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2914.jpg","date_sans_annee":"10/02 10:19","soutien":1,"score":0,"id":237016,"texte":"Euh... Ce n'est pas un peu des trois à la fois ? Enfin, jé dis ça, jé dis rien...\n\nN'a pas voté par conséquent, n'ayant pou faire UN choix..."},{"auteur":"Lia","compteur":2740,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/12.gif","date_sans_annee":"10/02 10:32","soutien":2,"score":2,"id":237026,"positifs":{"adapte":1,"humour":1},"texte":"Et bien Yul, il semble que si le baron a intriduit bien des choses en vous, il a oublié d'y ajouter une part de sa subtilité politique.\n\nLes trois propositions de cee votes sont bel et bien différentes pour la suite des évènements."},{"auteur":"Yul Harkonnen","compteur":499,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2914.jpg","date_sans_annee":"10/02 10:38","soutien":1,"score":0,"id":237031,"texte":"Dame Lia, vous savez comme yé vous apprécie... D'ailleurs j'ai toujours dis qué si j'avais été oune femme, jé vous aurais sûrément aimé...\n\nMais il mé semble - et jé rappelle qué jé né suis pas Vladimir - qué lé choix posé est de savoir si l'Assemblée est un pouvoir judiciaire, législatif, ou un simple lieu de débat...\n\nJé mé trompe ?"},{"auteur":"général locius","compteur":626,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1492.jpg","date_sans_annee":"10/02 10:38","score":0,"id":237032,"texte":"A voté!!"},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"10/02 10:50","score":0,"id":237047,"texte":"A voté"},{"auteur":"Encyclopédia","compteur":492,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2632.png","date_sans_annee":"10/02 10:54","soutien":1,"score":0,"id":237050,"texte":"Tagna : à voter"},{"auteur":"Ragnard","compteur":1318,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2793.jpg","date_sans_annee":"10/02 11:12","score":0,"id":237060,"texte":"A voté."},{"auteur":"Naathaniel du Désert","compteur":22,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2930.jpg","date_sans_annee":"10/02 11:22","score":0,"id":237079,"texte":"A voté..."},{"auteur":"Le Clan Yzocras","compteur":969,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2909.jpg","date_sans_annee":"10/02 11:23","score":0,"id":237080,"texte":"Nous avons voté(6/6)."},{"auteur":"lévèque","compteur":25,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3005.jpg","date_sans_annee":"10/02 11:31","score":0,"id":237089,"texte":"mince j'en ai marre de dire a voté!"},{"auteur":"black bird","compteur":772,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2538.jpg","date_sans_annee":"10/02 11:33","score":0,"id":237091,"texte":"pas moi, tant que j'accomplis mon devoir....\n\nA voté!"},{"auteur":"KiaX","compteur":178,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2865.jpg","date_sans_annee":"10/02 11:37","score":1,"id":237096,"positifs":{"adapte":1},"texte":"Exactement comme black bird c'est nôtre devoir de voté. . . . et c'est la meilleure façon de s'exprimer sur ce qu'on veut\n\nA voté !"},{"auteur":"cdt HALO","compteur":10,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2434.jpg","date_sans_annee":"10/02 11:58","score":0,"id":237108,"texte":"A voté"},{"auteur":"Dame Yuna","compteur":405,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2890.jpg","date_sans_annee":"10/02 12:05","score":0,"id":237117,"texte":"a votée"},{"auteur":"quirinus","compteur":820,"avatar":"archivesbeta.ap