,"compteur":159,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2594.jpg","date_sans_annee":"26/11 15:58","score":0,"id":190603,"texte":"a voté"},{"auteur":"Béhémothaure 7.1","compteur":409,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2273.gif","date_sans_annee":"26/11 18:04","soutien":2,"score":0,"id":190715,"texte":"a voté"},{"auteur":"Cdt paterson","compteur":3,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2266.jpg","date_sans_annee":"26/11 18:42","score":0,"id":190740,"texte":"A voté"},{"auteur":"Siegfried","compteur":237,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2645.gif","date_sans_annee":"26/11 19:32","soutien":2,"score":0,"id":190754,"texte":"A voté!"},{"auteur":"Leonard","compteur":9,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2550.gif","date_sans_annee":"26/11 19:38","score":0,"id":190761,"texte":"A voté"}],"4":[{"auteur":"Denior","compteur":3266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2049.jpg","date_sans_annee":"30/11 11:23","score":0,"id":192994,"texte":"Mes félicitations Aristippe pour votre brillante victoire et mes amiclaes pensées aux perdants qui ont mené une campagne pleine de dignité.\nIl est temps désormais de remettre notre République en marche, une marche vers la Paix et la sérénité.\nFort de la confiance du peuple, Aristippe vous serez notre guide efficace et rigoureux.\nBon courage"},{"auteur":"Général_Louis","compteur":1323,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1149.jpg","date_sans_annee":"30/11 11:50","score":0,"id":193004,"texte":"\"Bravo Aristippe BRAVO! Tu as été élu c'est G-E-N-I-A-L! Allez Aristippe familirise toi bien dans tes nouvelles fonctions et bonne chance.\""},{"auteur":"-[Aerÿnn]-","compteur":2661,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1478.gif","date_sans_annee":"30/11 11:58","soutien":1,"score":1,"id":193008,"positifs":{"adapte":1},"texte":"Nous tenons à féliciter tous les candidats également.\nSauf l'un d'entre eux, pas besoin de rapeller son nom...\n\nNous sommes persuadés que vous y arrivez, Commandant Aristippe.\nNous avons foi en vous, en vos capacités et surtout en votre humanisme.\n\nQu'Espérance et la Constitution se portent mieux.\n\nMes respects,\nGén. Hétag pour Flÿnna"},{"auteur":"général locius","compteur":626,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1492.jpg","date_sans_annee":"30/11 16:24","score":3,"id":193123,"positifs":{"humour":3},"texte":"Félicitations au gagnant et à ceux qui se sont présentés sauf un!!!(devinez qui??^^)\n\nJ'esperes qu'avec vous esperence se relevra.\n\nBRAVO"},{"auteur":"Empire Cronosite","compteur":1087,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2214.jpg","date_sans_annee":"30/11 18:41","score":1,"id":193317,"positifs":{"humour":1},"texte":"Esperons qu'elle n'aura pas des graines de dragon..."},{"auteur":"Forget","compteur":59,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2511.jpg","date_sans_annee":"30/11 21:33","score":0,"id":193448,"texte":"Arristipe?\nBah, tant mieux pour ceux qui ont voté pour lui...\nDe toute facon je n'ai que faire de la constitution donc ça change rien..."},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"30/11 21:42","score":1,"id":193455,"positifs":{"adapte":1},"texte":"Je suis désolé que vous preniez les choses de cette façon, commandant Forget...\nJe suis désolé que vous choisissiez de faire cavalier seul plutôt que de choisir l'alliance de Tous...\nMalgré vos dires, la porte ne reste pas fermée.\nJe tiens malgré tout à vous mettre en garde, vous pouvez vous moquer des mots de la Constitution, mais la République, si vous choisissez de transgresser ses lois, ne se moquera pas des maux que vous lui causerez !\nA Bon Entendeur !"},{"auteur":"Necromanger","compteur":121,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1052.gif","date_sans_annee":"03/12 18:55","score":1,"id":195243,"positifs":{"remarquable":1},"texte":"Belle victoire, cher Aristippe! La balle est dans votre camp, veillez à ce que la galaxie reste un lieu propice au respect des lois imposées. Encore bravo et bon courage également.\n\nDommage pour toi Blackstar, il est vrai qu'il ne manquait pas grand chose, mais ainsi va la vie! Et puis, tu as encore un long chemin à parcourir, donc ne t'en fait pas.\n\nEt maintenant: \"Alea jacta est\"!"}],"3":[{"auteur":"maître anubis","compteur":32,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2198.jpg","date_sans_annee":"26/11 19:57","score":1,"id":190767,"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"Caporal Atmos","compteur":109,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1843.jpg","date_sans_annee":"26/11 20:42","score":0,"id":190790,"texte":"a voté"},{"auteur":"ceail","compteur":422,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2236.jpg","date_sans_annee":"27/11 08:37","score":0,"id":190869,"texte":"a voté"},{"auteur":"Cruzador","compteur":76,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2590.jpg","date_sans_annee":"27/11 09:37","score":0,"id":190870,"texte":"a voté"},{"auteur":"Denior","compteur":3266,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2049.jpg","date_sans_annee":"27/11 10:13","score":0,"id":190880,"texte":"a voté"},{"auteur":"Llor","compteur":599,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2408.jpg","date_sans_annee":"27/11 10:31","score":0,"id":190883,"texte":"a voté"},{"auteur":"Felinia's return","compteur":354,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2507.jpg","date_sans_annee":"27/11 20:02","score":0,"id":191400,"texte":"A voté."},{"auteur":"valdred","compteur":105,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2200.jpg","date_sans_annee":"28/11 17:05","soutien":1,"score":0,"id":191727,"texte":"A voté"},{"auteur":"Necromanger","compteur":121,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1052.gif","date_sans_annee":"28/11 19:43","score":0,"id":191873,"texte":"A voté pour la personne qui mérite ce poste..."},{"auteur":"Cesco Imperator","compteur":3122,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"28/11 20:17","soutien":2,"score":7,"id":191908,"positifs":{"humour":7},"texte":"A déjà voté sans le dire, mais tiens à préciser à Necromanger que je n'etais pas candidat....mdr"},{"auteur":"Corto","compteur":13,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1552.jpg","date_sans_annee":"29/11 17:06","score":0,"id":192442,"texte":"A voté"},{"auteur":"Rosa L.","compteur":1595,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2330.jpg","date_sans_annee":"29/11 22:41","soutien":2,"score":0,"id":192907,"texte":"Félicitations Aristippe, c'était moins une....enfin moins 5!"},{"auteur":"-[Aerÿnn]-","compteur":2661,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1478.gif","date_sans_annee":"29/11 22:46","soutien":1,"score":0,"id":192910,"texte":"Communiqué : Vithö Argnarr\n\nOn peut voir le vieux pester sur son bureau.\nEnvoyant valser quelques dossiers, porte-crayons et d'autres fatras...\n\n- \"Rhaaaaa dommagee !! Grrrr....\"\n- \"Sire, vous êtes en ligne !\"\n\n'Merde...Bon soyons fair-play ahem...'\n\n\"Bravo à l'élu ! Cher Aristippe, je vous félicite ! C'était sérré...\nEt dommage également pour Blackstar, et les autres candidats.\nEnfin, je remerçie tous mes fans ! (mime un bisou à la caméra)\""},{"auteur":"Angus Young","compteur":419,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/925.gif","date_sans_annee":"29/11 23:09","score":0,"id":192916,"texte":"Bravo Aristippe.\nC'était serré, mais le peuple a tranché.\nLe futur nous dira si il à fait le bon choix, chose dont je ne doute pas ^^"},{"auteur":"Corbeau noir","compteur":1010,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2363.jpg","date_sans_annee":"29/11 23:17","soutien":1,"score":0,"id":192918,"texte":"Blacksatar, malgré nos récents disputtes, je tenais à vous féliciter d'avoir récolté autant de voix. Mais le peuple a tranché et je vous félicite Aristippe pour votre élection!"},{"auteur":"Blackstar","compteur":350,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2465.jpg","date_sans_annee":"29/11 23:20","score":0,"id":192922,"texte":"Merci Corbeau Noir, c'est fort aimable à vous; de même pour Hot Foot.\n\nDe plus, je félicite Aristippe pour son élection au poste d'Ambassadeur d'Espérance.\n\nBravo à lui."},{"auteur":"Hot foot","compteur":419,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2611.jpg","date_sans_annee":"29/11 23:21","score":0,"id":192924,"texte":"Felicitation a toi Aristippe.\nEt surtout bonne chance!\nTu vas en avoir besoin...\n\nDommage aux autres candidats et surtout a toi Blackstar..."},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"30/11 06:28","score":1,"id":192952,"positifs":{"remarquable":1},"texte":"Chers Commandants,\nChers Concitoyens,\nC'est avec Honneur, respect mais aussi beaucoup d'humilité que je reçois aujourd'hui la confiance qui émane de ce vote.\nJe prends la mesure de celle-ci et espère restez digne de l'Honneur qui m'est accordé.\nElu par une partie des représentants d'Espérance, je souhaite souligner à quel point je souhaite être le représentant de Tous, que l'Union autour de la république soit effectuée, une union saine, dans le respect de chacun...\nJe tiens à féliciter tous les candidats qui se sont présentés à cette élection, ils ont fait preuve de courage et d'engagement envers Espérance et vous tous ! Qu'Hommage leur soit rendu !\nJe souhaite que dans la même optique, ces commandants restent dans la ligne de leur engagement et qu'ils soient des modèles de probité pour tous.\nJe constate aussi avec une fierté non dissimulée et avec une grande joie que les candidats du MURE ont été élus aux postes qu'ils briguaient...\nC'est une démonstration de plus s'il en fallait, que l'engagement dont nous avons fait preuve est reconnue, tout comme la défense de nos idéaux.\nNous en prenons bonne note pour la conduite de nos actions !\nMerci à tous, commandants !\nLongue Vie à la République !"},{"auteur":"ceail","compteur":422,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2236.jpg","date_sans_annee":"30/11 07:47","score":0,"id":192970,"texte":"félicitation Aristippe pour votre victoire, que votre gouvernenement soit paix, développement"},{"auteur":"syl10","compteur":102,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2544.jpg","date_sans_annee":"30/11 11:00","score":1,"id":192990,"positifs":{"remarquable":1},"texte":"Vive le nouveau président, bonne chance pour ce mois à venir, vous prendrez les bonnes decisions pour nous tous!!!!\n\nBonne chance \"Espérance\" !!!!"}],"1":[{"auteur":"Cesco Imperator","compteur":3122,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"25/11 22:38","soutien":2,"score":4,"id":190046,"positifs":{"adapte":4},"texte":"Votez ici pour élire le futur Détenteur d'Ambassade pour le mois qui vient !\n\nQue le pouvoir civique s'exprime !\n\nDurée de 4 jours."},{"auteur":"Cloud","compteur":33,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2483.jpg","date_sans_annee":"25/11 22:51","score":0,"id":190050,"texte":"Mon peuple s'est exprimé ...\n\nAu suivant !"},{"auteur":"Rosa L.","compteur":1595,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2330.jpg","date_sans_annee":"25/11 22:52","soutien":2,"score":0,"id":190051,"texte":".......devinez"},{"auteur":"-[Aerÿnn]-","compteur":2661,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1478.gif","date_sans_annee":"25/11 22:53","soutien":1,"score":0,"id":190053,"texte":"J'ai donné ma voix, et donc donné cette chance au candidat choisi,\nd'améliorer le système et de gouverner sur Espérance !\n\n-\nVithö\nConseil des Vénérables"},{"auteur":"Hot foot","compteur":419,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2611.jpg","date_sans_annee":"25/11 23:06","score":0,"id":190060,"texte":"I have voted..."},{"auteur":"DarkDevil","compteur":569,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1543.jpg","date_sans_annee":"25/11 23:23","score":0,"id":190071,"texte":"A voté..."},{"auteur":"Angus Young","compteur":419,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/925.gif","date_sans_annee":"25/11 23:47","score":0,"id":190079,"texte":"--Done--"},{"auteur":"Corbeau noir","compteur":1010,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2363.jpg","date_sans_annee":"26/11 00:21","soutien":1,"score":1,"id":190083,"positifs":{"humour":1},"texte":"A fait la chose qu'il fallait faire dans cette salle..."},{"auteur":"Blackstar","compteur":350,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2465.jpg","date_sans_annee":"26/11 01:48","score":0,"id":190097,"texte":"Le PSDE à voté.\n\nEn espérant voir une future Espérance saine et pleine de bonnes choses...\n\nBlackstar."},{"auteur":"whiteh","compteur":37,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2619.jpg","date_sans_annee":"26/11 05:32","score":0,"id":190110,"texte":"A voté."},{"auteur":"C.H.0.A.M.","compteur":202,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2327.jpg","date_sans_annee":"26/11 05:50","score":0,"id":190112,"texte":"Avons votés."},{"auteur":"Angely","compteur":380,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2629.jpg","date_sans_annee":"26/11 06:15","score":0,"id":190117,"texte":"Vote déposé"},{"auteur":"Chris","compteur":68,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1992.jpg","date_sans_annee":"26/11 09:00","score":0,"id":190126,"texte":"A voté pour Espérance..."},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"26/11 09:22","score":0,"id":190131,"texte":"La Confédération Démocratique a voté"},{"auteur":"Général_Louis","compteur":1323,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1149.jpg","date_sans_annee":"26/11 09:22","score":0,"id":190132,"texte":"A VOTE POUR LE MEILLEUR DE TOUS!"},{"auteur":"rafale","compteur":18,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1880.jpg","date_sans_annee":"26/11 10:04","score":0,"id":190161,"texte":"mon peuple à voté au travers de moi\n\nrafale"},{"auteur":"Mystèrax","compteur":1216,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"26/11 10:28","score":0,"id":190176,"texte":"A voté encore une fois!"},{"auteur":"BP69","compteur":465,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1280.jpg","date_sans_annee":"26/11 10:30","score":0,"id":190184,"texte":"A voté"},{"auteur":"Mata Hari","compteur":12,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/888.jpg","date_sans_annee":"26/11 10:31","score":0,"id":190185,"texte":"choix difficile !\nmais puisqu'il faut voter !"},{"auteur":"lord eddard","compteur":169,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1444.gif","date_sans_annee":"26/11 11:04","soutien":2,"score":0,"id":190217,"texte":"a voté!"}]}}