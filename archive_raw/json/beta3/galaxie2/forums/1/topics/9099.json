sans_annee":"10/02 16:07","score":0,"id":237270,"texte":"a voté"},{"auteur":"Hatora la marchombre","compteur":159,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2594.jpg","date_sans_annee":"10/02 16:40","score":0,"id":237278,"texte":"A votée"},{"auteur":"Mystèrax","compteur":1216,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/797.jpg","date_sans_annee":"10/02 17:03","score":0,"id":237289,"texte":"Et voilà le dernier petit bout de papier!\n\nJ'ai voté!"},{"auteur":"Ansem","compteur":139,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2988.gif","date_sans_annee":"10/02 18:19","score":0,"id":237325,"texte":"D'après la formule consacrée...\nA voté"}],"1":[{"auteur":"Cesco Imperator","compteur":3122,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"10/02 10:44","soutien":2,"score":4,"id":237035,"positifs":{"remarquable":4},"texte":"\"Commandants, Commandantes,\n\nPour continuer notre projet pour VOTRE REGIME futur, je soulève votre opinion sur la façon dont le gouvernement devra obtenir ses moyens.\n\nSoyons précis. C'est bien beau d'attendre monts et merveilles de l'exécutif, mais sans argent on ne fait rien.\n\nOn peut considérer, vu le peu de Commandants qui payent les campagnes d'imposition, qu'il faut que le Gouvernement recours au mécénat, ce qui semble aléatoire, ou que le Détenteur soit riche...ce qui exclut les jeunes de la Candidature à Ambassade.\n\nMais peut-être le nombre de payeurs va-t-il augmenter...\n\nExprimez-vous,\n\nPour Galen et Espérance.\n\nTrois Jours de vote.\""},{"auteur":"maître anubis","compteur":32,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2198.jpg","date_sans_annee":"10/02 10:46","score":0,"id":237041,"texte":"A voté"},{"auteur":"général locius","compteur":626,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1492.jpg","date_sans_annee":"10/02 10:47","score":0,"id":237042,"texte":"A voté!!"},{"auteur":"Aristippe","compteur":906,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1634.gif","date_sans_annee":"10/02 10:49","score":0,"id":237046,"texte":"A voté"},{"auteur":"Encyclopédia","compteur":492,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2632.png","date_sans_annee":"10/02 10:52","soutien":1,"score":0,"id":237049,"texte":"Tagna : à voté ..."},{"auteur":"Angus Young","compteur":419,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/925.gif","date_sans_annee":"10/02 10:57","score":0,"id":237052,"texte":"Obtenir des moyens?\nBen, je vois moult possibilités :\n -Impôt de temps en temps su l'ensemble des commnadants.\n -Organisation de jeux (lottos, concerts pour la charité, concours arénà, olympiades poétique, concours de biographies...)\n -Dons de la part des plus riches, à titre de \"d'éfenseur de la paix en espérance, et du bien être de tous\" (volontariat, ou mécénat si je ne me trompe pas)\n -Commerce de masse\n -Fructification des leems des commnandants qui le souhaitent.\n\nPour celà, je pense qu'il serait bon de créer une cellule qui se chargerait de remplir un maximum des possibiliés citées précédement. Mais bon, peut-ètre que je m'avance un peu trop là...\n\nEdit:Désolé Cesco, je n'ai pas été trop présent ces jours-ci, et je n'ai pas vu de salle concernant en particulier les propositions finnancières."},{"auteur":"Cesco Imperator","compteur":3122,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/580.jpg","date_sans_annee":"10/02 11:02","soutien":2,"score":0,"id":237053,"texte":"\"Angus, il y aavait une salle pour des propositions...je n'ai fait que condenser..idées à retenir, considérons la comme le 4 ème choix...\""},{"auteur":"Général Turon","compteur":81,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2970.jpg","date_sans_annee":"10/02 11:10","score":0,"id":237058,"texte":"A voté"},{"auteur":"Rosa L.","compteur":1595,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2330.jpg","date_sans_annee":"10/02 11:11","soutien":2,"score":0,"id":237059,"texte":"A voté"},{"auteur":"Ragnard","compteur":1318,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2793.jpg","date_sans_annee":"10/02 11:14","score":0,"id":237063,"texte":"A voté"},{"auteur":"Naathaniel du Désert","compteur":22,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2930.jpg","date_sans_annee":"10/02 11:21","score":0,"id":237075,"texte":"A voté et se propose en tant que mécène."},{"auteur":"Le Clan Yzocras","compteur":969,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2909.jpg","date_sans_annee":"10/02 11:24","score":0,"id":237081,"texte":"Nous avons voté (6/6)."},{"auteur":"lévèque","compteur":25,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/3005.jpg","date_sans_annee":"10/02 11:30","score":0,"id":237088,"texte":"a re re voté!"},{"auteur":"black bird","compteur":772,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2538.jpg","date_sans_annee":"10/02 11:35","score":0,"id":237094,"texte":"a voté"},{"auteur":"KiaX","compteur":178,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2865.jpg","date_sans_annee":"10/02 11:40","score":0,"id":237100,"texte":"A voté"},{"auteur":"cdt HALO","compteur":10,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2434.jpg","date_sans_annee":"10/02 11:55","score":0,"id":237106,"texte":"A voté"},{"auteur":"quirinus","compteur":820,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/2870.jpg","date_sans_annee":"10/02 12:04","score":0,"id":237113,"texte":"a voté"},{"auteur":"Dame Yuna","compteu