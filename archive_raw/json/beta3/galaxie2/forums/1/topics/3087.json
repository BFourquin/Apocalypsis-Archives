apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/510.jpg","date_sans_annee":"18/05 16:52","score":1,"id":69033,"positifs":{"adapte":1},"texte":"A voté ^^"},{"auteur":"Kooshoku","compteur":156,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1285.jpg","date_sans_annee":"18/05 17:11","soutien":2,"score":2,"id":69089,"positifs":{"humour":2},"texte":"Lu et approuvé.\n\nOops, trompé de page."},{"auteur":"Sombrecoeur","compteur":387,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/835.gif","date_sans_annee":"18/05 17:30","soutien":1,"score":0,"id":69130,"texte":"A voté !"},{"auteur":"général locius","compteur":626,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1492.jpg","date_sans_annee":"18/05 17:43","score":1,"id":69146,"positifs":{"adapte":1},"texte":"A voté"},{"auteur":"Slarvick","compteur":46,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/874.gif","date_sans_annee":"18/05 17:46","score":1,"id":69153,"positifs":{"humour":1},"texte":"Faisons dans l'originalité...humm...je trouve pas.\nA voté alors!"},{"auteur":"Gunther","compteur":286,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/1238.jpg","date_sans_annee":"18/05 17:52","score":2,"id":69160,"positifs":{"humour":2},"texte":"Réponse A- Voté\n\nQuoi ma blague est merdique?"},{"auteur":"Erold Savostos.","compteur":138,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2/forums_galactiques/avatars/495.gif","date_sans_annee":"18/05 18:00","score":2,"id":69172,"positifs":{"efforts":1,"humour":1},"texte":"Une main grassouillette s’approche, elle tient fermement un petit bout de papier bleu.\nPuis, dans un mouvement gracieux et langoureux, elle lâche son étreinte et laisse virevolter le brouillon jusqu’au fond de la petite boite en inox.\n\n« A voté. »"}],"3":[{"auteur":"Nirgal","compteur":38,"avatar":"archivesbeta.apocalypsis.org/beta3/galaxie_2