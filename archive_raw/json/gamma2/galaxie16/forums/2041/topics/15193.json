50.gif","date":"2020-09-16 21:51","score":1,"id":278285,"positifs":{"adapte":1},"texte":"hé non un objet  pas un batiment"},{"auteur":"Sokhar","grade":"Cdt.","compteur":172,"avatar":"www.apocalypsis.org/avatars/10530.jpg","date":"2020-09-16 23:22","score":1,"id":278287,"positifs":{"roleplay":1},"texte":"Un talisman?"},{"auteur":"Vesh Kal","grade":"Cdte.","compteur":21,"avatar":"www.apocalypsis.org/avatars/10951.jpg","date":"2020-09-16 23:47","score":1,"id":278288,"positifs":{"roleplay":1},"texte":"Je propose la lettre E."},{"auteur":"Séphira","grade":"Cdt.","compteur":84,"avatar":"www.apocalypsis.org/avatars/10550.gif","date":"2020-09-17 01:13","score":1,"id":278289,"positifs":{"adapte":1},"texte":"gagné  c'était bien Talisman \nà vous  Sokhar"},{"auteur":"Sokhar","grade":"Cdt.","compteur":172,"avatar":"www.apocalypsis.org/avatars/10530.jpg","date":"2020-09-17 01:31","score":1,"id":278290,"positifs":{"roleplay":1},"texte":"Bien, voyons... Nous en sommes tous dotés mais par leurs attitudes certains en semblent dépourvus. \n\n_ _ _ U _"},{"auteur":"Kandra Ronan","grade":"Cdte.","compteur":59,"avatar":"www.apocalypsis.org/avatars/10938.jpg","date":"2020-09-17 05:49","soutien":2,"score":2,"id":278291,"positifs":{"adapte":1,"remarquable":1},"texte":"Une petite voix interrompit le silence. Il n'y avait pas d'hologramme seulement cette voix qui posait une question. \n\nUn Cœur ?"},{"auteur":"Kubaloukanakos","grade":"Cdt.","compteur":153,"avatar":"www.apocalypsis.org/avatars/10796.jpg","date":"2020-09-17 09:24","edite":true,"score":1,"id":278292,"positifs":{"humour":1},"texte":"\"FLEUR\"\n\nIl hurle très fort, levant sa trompette au dessus de la tête.\nPuis il se grate la tete.\n\n\"Nan mais j'avais pas entendu la description\""},{"auteur":"Sokhar","grade":"Cdt.","compteur":172,"avatar":"www.apocalypsis.org/avatars/10530.jpg","date":"2020-09-17 18:37","score":1,"id":278295,"positifs":{"adapte":1},"texte":"Commandante Kendra vous avez vu juste. A vous l'honneur tres chère."},{"auteur":"Kandra Ronan","grade":"Cdte.","compteur":59,"avatar":"www.apocalypsis.org/avatars/10938.jpg","date":"2020-09-17 19:14","soutien":2,"edite":true,"score":1,"id":278296,"positifs":{"roleplay":1},"texte":"_ _ _ _ A _ _ _ _\n \nLes civilisations peuvent en profiter, mais le gouvernement en est le maître."}],"1":[{"auteur":"Astronema","grade":"Cdte.","compteur":203,"avatar":"www.apocalypsis.org/avatars/10618.jpg","date":"2020-09-04 17:39","soutien":1,"score":1,"id":278109,"positifs":{"roleplay":1},"texte":"--------------------------\nI          /             I\nI     /                  I\nI                       O\nI                      / I \\\nI                       / \\\nI\n________________________\n\nJe pense que tous le monde connais ou a connu ce jeu a l'école...\nJe vais vous donnais le premier mot :\n\n????????\n\nEn 8 lettres , tous les commandants en on au moins 1.\nIl s'agit aussi d'un nom de voiture."},{"auteur":"Pandorre","grade":"Cdt.","compteur":6,"avatar":"www.apocalypsis.org/avatars/10909.jpg","date":"2020-09-04 18:55","score":1,"id":278111,"positifs":{"roleplay":1},"texte":"euh, pas la possibilité d'avoir un autre indice?\n\nje vous laisse vous faire pendre.\n\nS'en va réfléchir dans le fond de la salle."},{"auteur":"Astronema","grade":"Cdte.","compteur":203,"avatar":"www.apocalypsis.org/avatars/10618.jpg","date":"2020-09-04 19:46","soutien":1,"score":1,"id":278113,"positifs":{"adapte":1},"texte":"Je vais vous donnez quelques lettres:\n\nC???E??E"},{"auteur":"Zydfar","grade":"Cdt.","compteur":14,"avatar":"www.apocalypsis.org/avatars/10380.jpg","date":"2020-09-04 20:20","score":1,"id":278114,"positifs":{"roleplay":1},"texte":"Hmmmm...\n\nSi se pencher sur certains esprits et leur manière de communiquer est compliqué, cette devinette l'est un peu moins...\n\nUne Corvette était la solution à mon sens..."},{"auteur":"Astronema","grade":"Cdte.","compteur":203,"avatar":"www.apocalypsis.org/avatars/10618.jpg","date":"2020-09-04 20:27","soutien":1,"score":1,"id":278115,"positifs":{"roleplay":1},"texte":"Bien répondu Zydfar !\nVous pouvez prendre la suite si vous le désirez ...\nSinon je relancerais un nouveau."},{"auteur":"Pandorre","grade":"Cdt.","compteur":6,"avatar":"www.apocalypsis.org/avatars/10909.jpg","date":"2020-09-04 22:08","score":1,"id":278131,"positifs":{"roleplay":1},"texte":"Se relève et se rapproche. \n\nAh, vous avez bien dit que chaque commandant en a une, désolé de vous faire mentir astronema. \n\nBien joué zydfar, allez une suivante, je suis prêt."},{"auteur":"Astronema","grade":"Cdte.","compteur":203,"avatar":"www.apocalypsis.org/avatars/10618.jpg","date":"2020-09-15 18:43","soutien":1,"score":1,"id":278275,"positifs":{"roleplay":1},"texte":"Malheureusement Zydfar , me semble pas mal occupé.\nJe vais donc en relancer une :\n\nC-t---\n\nIl s'agit d'un aliment , on peut le cuisiner pour faire des gâteaux."},{"auteur":"Séphira","grade":"Cdt.","compteur":84,"avatar":"www.apocalypsis.org/avatars/10550.gif","date":"2020-09-15 23:51","score":1,"id":278279,"positifs":{"adapte":1},"texte":"aliment ou un fruit? ? citron?"},{"auteur":"Astronema","grade":"Cdte.","compteur":203,"avatar":"www.apocalypsis.org/avatars/10618.jpg","date":"2020-09-16 05:00","soutien":1,"score":1,"id":278280,"positifs":{"adapte":1},"texte":"Gagner !\n\nA vous Séphira ."},{"auteur":"Séphira","grade":"Cdt.","compteur":84,"avatar":"www.apocalypsis.org/avatars/10550.gif","date":"2020-09-16 18:52","score":1,"id":278283,"positifs":{"roleplay":1},"texte":"ok donc tentez de trouver un objet qui peu avoir une certaine valeur  et que nombre de commandants possédent probablement.\n\nT_ _ _ _ _ _ _"}],"9":[{"auteur":"Vesh Kal","grade":"Cdte.","compteur":21,"avatar":"www.apocalypsis.org/avatars/10951.jpg","date":"2020-09-19 20:05","score":0,"id":278372,"texte":"Hoho, deux bonnes réponses !\n\n_ R _ _ _ E N _ _ _ _ _ _ N"},{"auteur":"Zaerdin BURG","grade":"Cdt.","compteur":4,"avatar":"www.apocalypsis.org/avatars/10954.jpg","date":"2020-09-